   retriesLeft: number = 20, generation?: number) {
 const myGeneration = generation ?? ++goalsGeneration
-console.info('sending rpc request to load the proof state')
+console.info(`sending rpc request to load the proof state for ${worldId}/${levelId} (${uri})`)
 
 rpcSess.call('Game.getProofState',
     {

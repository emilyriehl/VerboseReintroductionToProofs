+++ b/client/src/components/infoview/goals.tsx
@@ -368,7 +368,7 @@ export const FilteredGoals = React.memo(({ headerChildren, goals }: FilteredGoal
  * editor mode. It sets `column` to a number only when it found tactic info at a position, so
  * zero goals with `column == null` means "no data yet", not "all goals solved".
  */
-function isProofGoalsComplete(proof: ProofState): boolean {
+export function isProofGoalsComplete(proof: ProofState): boolean {
   if (proof.steps.length < 2) return false
   if (proof.steps[0].goals.length === 0) return false
   const lastIdx = lastStepHasErrors(proof)
@@ -379,6 +379,15 @@ function isProofGoalsComplete(proof: ProofState): boolean {
   return lastStep.goals.length === 0 && lastStep.column != null
 }
 
+/** Return the proof state with `completed` flags cleared unless the goals confirm completion. */
+export function validateProofCompletion(proof: ProofState | undefined): ProofState | undefined {
+  if (!proof) return proof
+  if ((proof.completed || proof.completedWithWarnings) && !isProofGoalsComplete(proof)) {
+    return { ...proof, completed: false, completedWithWarnings: false }
+  }
+  return proof
+}
+

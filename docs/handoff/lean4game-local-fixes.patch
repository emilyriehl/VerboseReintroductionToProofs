+++ b/client/src/components/infoview/rpc_api.ts
@@ -61,6 +61,10 @@ export interface InteractiveGoalsWithHints {
   goals: InteractiveGoalWithHints[];
   command: string;
   diags: InteractiveDiagnostic[];
+  line?: number;
+  /** Set to a number when the server found tactic info at this position,
+   *  null/undefined when it did not (e.g. while still processing an edit). */
+  column?: number;
 }
 
 /**
diff --git a/client/src/components/infoview/typewriter.tsx b/client/src/components/infoview/typewriter.tsx
index 64db45f..c500afb 100644
--- a/client/src/components/infoview/typewriter.tsx
+++ b/client/src/components/infoview/typewriter.tsx
@@ -68,7 +68,9 @@ export function Typewriter({disabled}: {disabled?: boolean}) {
           pos,
           editor.getModel()?.getFullModelRange().getEndPosition()
         ),
-        text: typewriter.trim() + "\n",
+        // Verbose-style phrases read like sentences, so players may end them with a period.
+        // Lean would read a trailing `.` as the start of a projection (`p.1`), so drop it.
+        text: typewriter.trim().replace(/\.+$/, "").trimEnd() + "\n",
         forceMoveMarkers: false
       }])

 3 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/client/src/components/infoview/goals.tsx b/client/src/components/infoview/goals.tsx
index 862f8d3..c6e62be 100644
--- a/client/src/components/infoview/goals.tsx
+++ b/client/src/components/infoview/goals.tsx
@@ -360,6 +360,25 @@ export const FilteredGoals = React.memo(({ headerChildren, goals }: FilteredGoal
     </div>
 })
 
+/**
+ * Check whether the proof goals actually demonstrate completion.
+ *
+ * Adapted from lean4game PR #455 (fix for issues #402/#453). The server sets `completed` from the
+ * absence of diagnostics, which is transiently true while it is still processing fast edits in
+ * editor mode. It sets `column` to a number only when it found tactic info at a position, so
+ * zero goals with `column == null` means "no data yet", not "all goals solved".
+ */
+function isProofGoalsComplete(proof: ProofState): boolean {
+  if (proof.steps.length < 2) return false
+  if (proof.steps[0].goals.length === 0) return false
+  const lastIdx = lastStepHasErrors(proof)
+    ? proof.steps.length - 2
+    : proof.steps.length - 1
+  if (lastIdx < 1) return false
+  const lastStep = proof.steps[lastIdx]
+  return lastStep.goals.length === 0 && lastStep.column != null
+}
+
 export function loadGoals(
   rpcSess: RpcSessionAtPos,
   uri: string,
@@ -379,7 +398,12 @@ rpcSess.call('Game.getProofState',
     if (typeof proof !== 'undefined') {
       console.info(`received a proof state!`)
       console.log(proof)
-      setProof(proof as ProofState)
+      let proofState = proof as ProofState
+      // Cross-validate `completed` against the goal state (see isProofGoalsComplete).
+      if ((proofState.completed || proofState.completedWithWarnings) && !isProofGoalsComplete(proofState)) {
+        proofState = { ...proofState, completed: false, completedWithWarnings: false }
+      }
+      setProof(proofState)
       setCrashed(false)
     } else {
       console.warn('received undefined proof state!')
diff --git a/client/src/components/infoview/rpc_api.ts b/client/src/components/infoview/rpc_api.ts
index aebdd8b..a49ca26 100644

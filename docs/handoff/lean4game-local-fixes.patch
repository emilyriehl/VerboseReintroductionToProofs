From adb1ba3ab84e3f0b4e91fa01816745d5a9b5b3f7 Mon Sep 17 00:00:00 2001
From: emilyriehl <eriehl@jhu.edu>
Date: Mon, 26 Oct 2026 16:43:23 +0100
Subject: [PATCH 3/9] Typewriter: do not show the Crashed banner for a
 closed-document race on level change

After a level switch the first proof-state request can hit the document that was just closed; with requests to closed documents no longer retried, the rejection reached loadGoals and set the crashed flag until the next successful response, flashing the banner. Treat that error like a missing connection.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 client/src/components/infoview/goals.tsx | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/client/src/components/infoview/goals.tsx b/client/src/components/infoview/goals.tsx
index a081835..5f2ae6b 100644
--- a/client/src/components/infoview/goals.tsx
+++ b/client/src/components/infoview/goals.tsx
@@ -420,7 +420,11 @@ rpcSess.call('Game.getProofState',
     }
   }
 ).catch((error) => {
-  if (error === 'No connection to Lean') {
+  const message = String((error && typeof error === 'object' && 'message' in error) ? error.message : error)
+  // 'No connection to Lean': the server is still starting. 'closed file': the request raced a
+  // level change and hit the document that was just closed; the next request targets the new
+  // document. Neither is a crash of the player's proof, so don't flash the "Crashed!" banner.
+  if (message === 'No connection to Lean' || /closed file/i.test(message)) {
     console.warn(error)
     return
   }
-- 
2.53.0


